{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "4321",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/projects/",
        "http://localhost:4321/projects/icfesbot/",
        "http://localhost:4321/research/",
        "http://localhost:4321/blog/making-algorithmic-transparency-meaningful/",
        "http://localhost:4321/es/",
        "http://localhost:4321/team/"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
