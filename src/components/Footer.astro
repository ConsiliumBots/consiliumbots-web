---
import { useTranslations, localizePath } from '../i18n.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const footerLinks = [
  { key: 'nav.home', base: '/' },
  { key: 'nav.whatWeDo', base: '/what-we-do' },
  { key: 'nav.projects', base: '/projects' },
  { key: 'nav.research', base: '/research' },
  { key: 'nav.workingPapers', href: 'https://consiliumbots.github.io/working-papers-cb/', external: true },
  { key: 'nav.team', base: '/team' },
  { key: 'nav.blog', base: '/blog' },
  { key: 'nav.contact', base: '/contact' },
];
---

<footer class="footer">
  <div class="footer-inner wrap">
    <div class="footer-grid">
      <div class="footer-info">
        <p class="footer-address">
          102 Audubon Street, Floor 2<br />
          New Haven, CT 06510<br /><br />
          Av. Apoquindo 5950,<br />
          Las Condes, Santiago, Chile
        </p>
      </div>

      <div class="footer-nav">
        {footerLinks.map(link => (
          <a
            href={link.external ? link.href : localizePath(link.base, lang)}
            class="footer-link"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {t(link.key)}
            <img src="/icons/arrow-outward-white.svg" alt="" width="14" class="footer-link-arrow" />
          </a>
        ))}
      </div>

      <div class="footer-social">
        <a href="https://twitter.com/ConsiliumBots" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <img src="/icons/x-twitter.svg" alt="X" width="20" />
        </a>
        <a href="https://www.linkedin.com/company/consiliumbots/about/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <img src="/icons/linkedin.svg" alt="LinkedIn" width="20" />
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-mission">{t('footer.mission')}</p>
      <p class="footer-legal">
        <span>© {new Date().getFullYear()} {t('footer.legalEntity')}</span>
        <a href={localizePath('/privacy', lang)}>{t('footer.privacy')}</a>
        <a href={localizePath('/accessibility', lang)}>{t('footer.accessibility')}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary);
    color: var(--color-white);
    padding: 64px 0 40px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer-address {
    font-size: 0.875rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--color-white);
    opacity: 0.85;
    transition: opacity 0.2s ease;
    padding: 4px 0;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-link-arrow {
    opacity: 0.6;
  }

  .footer-social {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .footer-social a {
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .footer-social a:hover {
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 24px;
  }

  .footer-mission {
    font-size: 0.85rem;
    opacity: 0.7;
    max-width: 700px;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 14px;
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .footer-legal a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
