---
import { localizePath, useTranslations } from '../i18n.js';

const { post, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const { title, description, pubDate, authors = [], heroImage, tags = [] } = post.data;
const slug = post.id.replace(/^(en|es)\//, '');
const href = localizePath(`/blog/${slug}`, lang);
const locale = lang === 'es' ? 'es-ES' : 'en-US';
const dateLabel = pubDate.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// Only the "original is in English" case is supported today; guard on it
// explicitly so the notice can never label a post with the wrong language.
const foreign = lang !== 'en' && post.data.lang === 'en';
---

<article class="card">
  <a href={href} class="card-link">
    {heroImage && (
      <div class="card-thumb">
        <img src={heroImage} alt="" loading="lazy" />
      </div>
    )}
    <div class="card-body">
      <div class="card-meta">
        <time datetime={pubDate.toISOString()}>{dateLabel}</time>
        {tags.length > 0 && <span class="card-tag">{tags[0]}</span>}
      </div>
      <h2>{title}</h2>
      <p class="card-desc">{description}</p>
      {authors.length > 0 && <p class="card-authors">{authors.join(' · ')}</p>}
      {foreign && <p class="card-notice">{t('blog.englishNotice')}</p>}
      <span class="card-more">{t('blog.readMore')} →</span>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-white);
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }
  .card:hover {
    box-shadow: 0 6px 24px rgba(26, 58, 92, 0.09);
    transform: translateY(-2px);
  }
  .card-link {
    display: block;
    height: 100%;
  }
  .card-thumb {
    background: var(--color-bg-light);
    border-bottom: 1px solid var(--color-border);
  }
  .card-thumb img {
    width: 100%;
    height: auto;
    display: block;
  }
  .card-body {
    padding: 24px 26px 28px;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }
  .card-tag {
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 2px 10px;
    font-weight: 500;
  }
  .card h2 {
    font-size: 1.3rem;
    line-height: 1.3;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .card-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-light);
    margin-bottom: 12px;
  }
  .card-authors {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }
  .card-notice {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: 12px;
  }
  .card-more {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
  }
</style>
