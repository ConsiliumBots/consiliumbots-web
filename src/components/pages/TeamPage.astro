---
// Shared template for /team and /es/team — the routes only pass `lang`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamPhoto from '../TeamPhoto.astro';
import { activeTeam, researchAffiliates, researchAssociates, board, alumni } from '../../data/site-data.js';

const { lang = 'en' } = Astro.props;

const copy = {
  en: {
    title: 'Team | ConsiliumBots',
    description:
      'A diverse, interdisciplinary team based in the US, Chile, and Colombia, working alongside a network of affiliated researchers.',
    heading: 'Team',
    intro:
      "We're a diverse, interdisciplinary team based in the US, Chile, and Colombia, working alongside a network of affiliated researchers.",
    videoLabel: 'The ConsiliumBots team together at an event',
    videoPause: 'Pause video',
    videoPlay: 'Play video',
    team: 'ConsiliumBots team',
    website: 'Website',
    affiliates: 'Research affiliates',
    associates: 'Research associates',
    board: 'Board',
    alumni: 'Alumni',
    alumniLede: 'Former team members now working in government, industry, and doctoral programs around the world.',
    stats: {
      all: ['Alumni', 'Colleagues who have gone on to new roles.'],
      academia: ['Went on to graduate study', 'Doctoral and public policy programs at leading universities.'],
      government: ['Joined government', 'Education and labour ministries, carrying the work into public service.'],
      industry: ['Moved into industry', 'Technology and mission-driven organizations.'],
    },
  },
  es: {
    title: 'Equipo | ConsiliumBots',
    description:
      'Un equipo diverso e interdisciplinario con base en EE. UU., Chile y Colombia, que trabaja junto a una red de investigadores afiliados.',
    heading: 'Equipo',
    intro:
      'Somos un equipo diverso e interdisciplinario con base en EE. UU., Chile y Colombia, que trabaja junto a una red de investigadores afiliados.',
    videoLabel: 'El equipo de ConsiliumBots reunido en un evento',
    videoPause: 'Pausar el video',
    videoPlay: 'Reproducir el video',
    team: 'Equipo de ConsiliumBots',
    website: 'Sitio web',
    affiliates: 'Investigadores afiliados',
    associates: 'Investigadores asociados',
    board: 'Directorio',
    alumni: 'Ex integrantes',
    alumniLede:
      'Antiguos miembros del equipo que hoy trabajan en gobiernos, en la industria y en programas de doctorado alrededor del mundo.',
    stats: {
      all: ['Ex integrantes', 'Colegas que han seguido otros caminos.'],
      academia: ['Continuaron estudios de posgrado', 'Programas de doctorado y de políticas públicas en universidades líderes.'],
      government: ['Se integraron al sector público', 'Ministerios de educación y trabajo, llevando el trabajo al servicio público.'],
      industry: ['Pasaron a la industria', 'Empresas de tecnología y organizaciones con propósito social.'],
    },
  },
}[lang];

const initials = (name) =>
  name
    .split(' ')
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Most recent departures first; undated entries sink to the bottom.
const alumniByYear = [...alumni].sort(
  (a, b) => Number(b.departedYear ?? 0) - Number(a.departedYear ?? 0)
);

// Derived from the data so the counts never drift from the list below.
// Deliberately no "since <year>" claim: ConsiliumBots was founded in 2018 and
// the roster of early alumni is still incomplete, so a derived earliest year
// would understate the organization's history.
const byType = (t) => alumni.filter((m) => m.destinationType === t).length;

const alumniStats = [
  { n: alumni.length, ...labelled(copy.stats.all) },
  { n: byType('academia'), ...labelled(copy.stats.academia) },
  { n: byType('government'), ...labelled(copy.stats.government) },
  { n: byType('industry'), ...labelled(copy.stats.industry) },
].filter((s) => s.n > 0);

function labelled([label, desc]) {
  return { label, desc };
}
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <link slot="head" rel="preload" as="image" href="/videos/team-loop-poster.webp" fetchpriority="high" />
  <section class="page-hero">
    <div class="wrap hero-grid">
      <div>
        <h1>{copy.heading}</h1>
        <p>{copy.intro}</p>
      </div>
      <figure class="team-figure">
        <video
          class="team-video"
          src="/videos/team-loop.mp4"
          poster="/videos/team-loop-poster.webp"
          autoplay
          loop
          muted
          playsinline
          width="600"
          height="336"
        ></video>
        <button type="button" class="video-toggle" data-pause={copy.videoPause} data-play={copy.videoPlay}>
          {copy.videoPause}
        </button>
        <figcaption>{copy.videoLabel}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">{copy.team}</h2>
      <div class="team-grid">
        {activeTeam.map((m) => (
          <div class="card member">
            <div class="member-head">
              {m.photo ? (
                <TeamPhoto class="member-photo" photo={m.photo} name={m.name} size={56} />
              ) : (
                <div class="avatar-initials">{initials(m.name)}</div>
              )}
              <div>
                <h3>{m.name}</h3>
                <p class="member-title">{m.title}</p>
                {m.location && <p class="member-loc">{m.location}</p>}
              </div>
            </div>
            {m.bio && <p class="member-bio">{m.bio}</p>}
            {m.expertise.length > 0 && (
              <div class="tag-row">{m.expertise.slice(0, 5).map((e) => <span class="tag">{e}</span>)}</div>
            )}
            {(m.website || m.scholar) && (
              <p class="member-links">
                {m.website && <a href={m.website} target="_blank" rel="noopener noreferrer">{copy.website}</a>}
                {m.scholar && <a href={m.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2 class="section-title">{copy.affiliates}</h2>
      <div class="researcher-grid">
        {researchAffiliates.map((r) => (
          <figure class="researcher">
            {r.photo ? (
              <TeamPhoto photo={r.photo} name={r.name} size={120} />
            ) : (
              <div class="avatar-initials avatar-lg">{initials(r.name)}</div>
            )}
            <figcaption>
              <span class="researcher-name">{r.name}</span>
              {r.title && <span class="researcher-title">{r.title}</span>}
              {(r.website || r.scholar) && (
                <span class="researcher-links">
                  {r.website && <a href={r.website} target="_blank" rel="noopener noreferrer">{copy.website}</a>}
                  {r.scholar && <a href={r.scholar} target="_blank" rel="noopener noreferrer">Scholar</a>}
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">{copy.associates}</h2>
      <ul class="associate-list">
        {researchAssociates.map((m) => (
          <li>
            <strong>{m.name}</strong>
            {m.title && <span class="associate-title"> — {m.title}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2 class="section-title">{copy.board}</h2>
      <div class="board-grid">
        {board.map((b) => (
          <figure class="board-member">
            {b.photo ? (
              <TeamPhoto photo={b.photo} name={b.name} size={140} />
            ) : (
              <div class="avatar-initials avatar-lg">{initials(b.name)}</div>
            )}
            <figcaption>
              <span class="researcher-name">{b.name}</span>
              {b.title && <span class="researcher-title">{b.title}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">{copy.alumni}</h2>
      <p class="alumni-lede">{copy.alumniLede}</p>
      <div class="alumni-stats">
        {alumniStats.map((s) => (
          <div class="alumni-stat">
            <div class="alumni-stat-number">{s.n}</div>
            <div class="alumni-stat-label">{s.label}</div>
            <p class="alumni-stat-desc">{s.desc}</p>
          </div>
        ))}
      </div>
      <ul class="alumni-list">
        {alumniByYear.map((m) => (
          <li class="alumni-row">
            <span class="alumni-year">{m.departedYear}</span>
            <span class="alumni-person">
              <span class="alumni-name">{m.name}</span>
              {m.title && <span class="alumni-role">{m.title}</span>}
            </span>
            {m.currentPosition && <span class="alumni-now">{m.currentPosition}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // The loop autoplays muted; the button lets anyone stop it (WCAG 2.2.2)
  // and reduced-motion users get the poster instead.
  const v = document.querySelector<HTMLVideoElement>('.team-video');
  const btn = document.querySelector<HTMLButtonElement>('.video-toggle');
  if (v && btn) {
    const sync = () => {
      btn.textContent = v.paused ? (btn.dataset.play ?? 'Play') : (btn.dataset.pause ?? 'Pause');
    };
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
      v.pause();
    }
    btn.addEventListener('click', () => {
      if (v.paused) v.play().catch(() => {});
      else v.pause();
    });
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    sync();
  }
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 48px;
    align-items: center;
  }
  .team-figure {
    position: relative;
    margin: 0;
  }
  .team-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 12px 32px rgb(var(--navy-rgb) / 0.18);
  }
  .team-figure figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .video-toggle {
    position: absolute;
    right: 12px;
    bottom: 12px;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-white);
    background: rgb(var(--navy-rgb) / 0.6);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
    backdrop-filter: blur(4px);
  }
  .video-toggle:hover {
    background: rgb(var(--navy-rgb) / 0.8);
  }
  .video-toggle:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .team-figure {
      max-width: 480px;
    }
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .member {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .member-head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  /* :global() — the imgs are rendered inside TeamPhoto, outside this page's scope */
  .member-head :global(.member-photo) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .member-head h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .member-title {
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
    margin: 2px 0 0;
  }
  .member-loc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }
  .member-bio {
    font-size: 0.88rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }
  .member-links {
    display: flex;
    gap: 16px;
    margin: 0;
  }
  .member-links a {
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .researcher-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 28px;
  }
  .researcher,
  .board-member {
    text-align: center;
    margin: 0;
  }
  .researcher :global(img),
  .board-member :global(img) {
    width: 100%;
    max-width: 120px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto 10px;
  }
  .board-member :global(img) {
    max-width: 140px;
  }
  .researcher-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 4px;
    font-size: 0.8rem;
  }
  .researcher-links a {
    color: var(--color-accent);
    font-weight: 500;
  }
  .researcher-links a:hover {
    text-decoration: underline;
  }
  .avatar-lg {
    width: 120px;
    height: 120px;
    font-size: 1.6rem;
    margin: 0 auto 10px;
  }
  .researcher-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .researcher-title {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 3px;
    line-height: 1.45;
  }

  .associate-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
  }
  .associate-list li {
    font-size: 0.95rem;
  }
  .associate-title {
    color: var(--color-text-muted);
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .alumni-lede {
    color: var(--color-text-light);
    max-width: 60ch;
    margin: -8px 0 28px;
  }
  .alumni-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin: 0 0 40px;
  }
  .alumni-stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .alumni-stat-label {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .alumni-stat-desc {
    font-size: 0.85rem;
    color: var(--color-text-light);
    line-height: 1.5;
    margin: 0;
  }
  @media (max-width: 900px) {
    .alumni-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 480px) {
    .alumni-stats {
      grid-template-columns: 1fr;
    }
  }

  .alumni-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .alumni-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .alumni-year {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }
  .alumni-person {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .alumni-name {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .alumni-role {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .alumni-now {
    font-size: 0.88rem;
    color: var(--color-text-light);
  }
  .alumni-now::before {
    content: '→ ';
    color: var(--color-accent);
  }
  @media (max-width: 640px) {
    .alumni-row {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .alumni-now {
      grid-column: 2;
    }
  }
  .board-member figcaption {
    max-width: 240px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .researcher-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .board-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
    .researcher-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .board-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
