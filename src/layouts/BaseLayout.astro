---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { GA_MEASUREMENT_ID } from '../config.js';
import { stripLang, localizePath, useTranslations } from '../i18n.js';
// Self-hosted variable font (one file covers weights 100-900) — no third-party request
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: 'en' | 'es';
  bilingual?: boolean;
  /** Canonicalize to this path instead of the page's own URL (e.g. untranslated /es/blog/ fallbacks point at the English post). */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  /** Emitted as article:* meta when ogType is "article". */
  article?: { publishedTime: string; modifiedTime?: string };
  /** Extra Schema.org nodes appended to the JSON-LD @graph. */
  extraSchema?: Record<string, unknown>[];
  /** Where the nav language switcher lands when the page has no translation (bilingual={false}). */
  langSwitchBase?: string;
  /** Language of the page's main content when it differs from the chrome (untranslated fallbacks). Drives og:locale. */
  contentLang?: 'en' | 'es';
  /** Ask crawlers not to index (e.g. the 404 page); also suppresses the canonical link. */
  noindex?: boolean;
}

const {
  title,
  description = 'Using technology to help families make important decisions in education and other social impact areas. Working with governments to reach out to their users.',
  ogImage = '/images/og-image.png',
  lang = 'en',
  bilingual = true,
  canonicalPath,
  ogType = 'website',
  article,
  extraSchema = [],
  langSwitchBase = '/',
  contentLang = lang,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);

// GitHub Pages serves the trailing-slash directory URLs; the slash-less form
// 301-redirects, so canonical and hreflang must both use the slash form.
const withTrailingSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const canonicalUrl = new URL(withTrailingSlash(canonicalPath ?? Astro.url.pathname), Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://www.consiliumbots.com';

// hreflang alternates (only emitted when the page exists in both languages)
const basePath = stripLang(Astro.url.pathname);
const enHref = new URL(withTrailingSlash(localizePath(basePath, 'en')), Astro.site);
const esHref = new URL(withTrailingSlash(localizePath(basePath, 'es')), Astro.site);
const ogLocale = contentLang === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlt = contentLang === 'es' ? 'en_US' : 'es_ES';

// Organization + WebSite structured data (Schema.org) for entity recognition
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'ConsiliumBots',
      legalName: 'ConsiliumBots, Inc.',
      nonprofitStatus: 'Nonprofit501c3',
      foundingDate: '2018-12',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/images/consiliumbots-logo.svg`,
      description:
        'A technology nonprofit using data and AI to help people make better decisions about education, housing, and government benefits across Latin America and the U.S.',
      sameAs: [
        'https://twitter.com/ConsiliumBots',
        'https://www.linkedin.com/company/consiliumbots/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'ConsiliumBots',
      url: `${siteUrl}/`,
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    ...extraSchema,
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

    {bilingual && (
      <>
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="es" href={esHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ConsiliumBots" />
    <meta property="og:locale" content={ogLocale} />
    {bilingual && <meta property="og:locale:alternate" content={ogLocaleAlt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ConsiliumBots" />
    <meta name="twitter:creator" content="@ConsiliumBots" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Fonts are self-hosted via @fontsource (imported in the layout frontmatter) -->

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- Blog feed -->
    <link rel="alternate" type="application/rss+xml" title="ConsiliumBots Blog" href="/rss.xml" />

    <!-- Structured data (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Analytics 4 (only rendered when a Measurement ID is configured) -->
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`}></script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
    <Navbar lang={lang} bilingual={bilingual} switchBase={langSwitchBase} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
