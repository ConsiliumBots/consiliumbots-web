---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { useTranslations } from '../../i18n.js';
import { getPostsFor } from '../../lib/posts.js';

const lang = 'en';
const t = useTranslations(lang);
const posts = await getPostsFor(lang);
---

<BaseLayout
  title="Blog — ConsiliumBots"
  description="Notes on the research and the systems behind it — what we are learning from building information tools with governments."
  lang={lang}
>
  <section class="section">
    <div class="wrap">
      <header class="blog-head">
        <h1>{t('blog.title')}</h1>
        <p class="lead">{t('blog.intro')}</p>
      </header>

      {posts.length === 0 ? (
        <p class="blog-empty">{t('blog.empty')}</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => <PostCard post={post} lang={lang} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-head {
    max-width: 720px;
    margin-bottom: 48px;
  }
  .blog-head h1 {
    margin-bottom: 16px;
  }
  .lead {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-light);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 28px;
  }
  .blog-empty {
    color: var(--color-text-muted);
  }
  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
