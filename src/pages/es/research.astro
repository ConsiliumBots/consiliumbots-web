---
import BaseLayout from '../../layouts/BaseLayout.astro';
import publications from '../../data/publications.json';
import { projects } from '../../data/site-data.js';

const nameBySlug = Object.fromEntries(projects.map((p) => [p.slug, p.name]));

const byCategory = (c) =>
  publications.filter((p) => p.category === c).sort((a, b) => (b.year ?? 0) - (a.year ?? 0));

const sections = [
  {
    id: 'journal',
    title: 'Publicaciones con revisión de pares',
    blurb:
      'Investigación con revisión de pares de nuestro equipo e investigadores afiliados sobre elección de escuela, asignación centralizada e intervenciones informativas.',
    items: byCategory('journal'),
  },
  {
    id: 'working-papers',
    title: 'Documentos de trabajo',
    blurb:
      'Investigación en curso, incluida la Serie de Documentos de Trabajo de ConsiliumBots y artículos de nuestros investigadores afiliados.',
    items: byCategory('working-paper'),
  },
  {
    id: 'reports',
    title: 'Informes de proyectos y evaluaciones',
    blurb:
      'Informes finales y evaluaciones de impacto elaborados junto a nuestros socios gubernamentales y financiadores.',
    items: byCategory('report'),
  },
  {
    id: 'motivating',
    title: 'Investigación que motiva nuestro trabajo',
    blurb: 'Evidencia fundamental que orienta el diseño de nuestras intervenciones.',
    items: byCategory('motivating'),
  },
];

const total = publications.length;

// Datos estructurados para que los buscadores indexen estos trabajos académicos.
const publicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Publicaciones de las colaboraciones de ConsiliumBots',
  numberOfItems: total,
  itemListElement: publications.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'ScholarlyArticle',
      name: p.title,
      url: p.url,
      ...(p.year ? { datePublished: String(p.year) } : {}),
      ...(p.authors ? { author: { '@type': 'Person', name: p.authors } } : {}),
      ...(p.venue ? { publication: p.venue } : {}),
    },
  })),
};
---

<BaseLayout
  lang="es"
  title="Publicaciones e Investigación | ConsiliumBots"
  description="Publicaciones con revisión de pares, documentos de trabajo y evaluaciones de impacto producidos a través de las colaboraciones de ConsiliumBots en elección de escuela, admisión universitaria e intervenciones informativas."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Publicaciones e Investigación</h1>
      <p>
        Nuestros proyectos permiten producir evidencia rigurosa sobre soluciones a problemas
        sociales y avanzar en el conocimiento en colaboración con nuestros investigadores
        afiliados. A continuación están las publicaciones, documentos de trabajo y evaluaciones
        que han surgido de estas colaboraciones.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {sections.filter((s) => s.items.length > 0).map((section) => (
        <div class="pub-section">
          <h2 class="section-title" id={section.id}>{section.title}</h2>
          <p class="section-blurb">{section.blurb}</p>
          <div class="pub-list">
            {section.items.map((p) => (
              <div class="pub">
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="pub-main">
                  <div>
                    <span class="pub-title">{p.title}</span>
                    <span class="pub-meta">
                      {[p.authors, p.venue, p.year].filter(Boolean).join(' · ')}
                    </span>
                  </div>
                  <img src="/icons/arrow-outward.svg" alt="" width="16" />
                </a>
                {(p.project || p.extraLinks) && (
                  <div class="pub-links">
                    {p.project && nameBySlug[p.project] && (
                      <a href={`/projects/${p.project}`} class="pub-tag">
                        {nameBySlug[p.project]}
                      </a>
                    )}
                    {(p.extraLinks ?? []).map((l) => (
                      <a href={l.url} target="_blank" rel="noopener noreferrer" class="pub-tag pub-tag-alt">
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap more-links">
      <a class="btn btn-primary" href="https://consiliumbots.github.io/working-papers-cb/" target="_blank" rel="noopener noreferrer">
        Repositorio de documentos de trabajo
        <img src="/icons/arrow-outward-white.svg" alt="" width="16" />
      </a>
      <a class="btn-arrow" href="https://scholar.google.com/citations?user=6MZfok0AAAAJ" target="_blank" rel="noopener noreferrer">
        Christopher Neilson en Google Scholar
        <img src="/icons/arrow-outward.svg" alt="" width="16" />
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(publicationSchema)} />
</BaseLayout>

<style>
  .pub-section {
    margin-bottom: 56px;
  }
  .pub-section:last-child {
    margin-bottom: 0;
  }
  .section-blurb {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    max-width: 640px;
    margin: -8px 0 20px;
  }
  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pub {
    border-radius: 8px;
    transition: background 0.2s ease;
  }
  .pub:hover {
    background: var(--color-bg-light);
  }
  .pub-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px 6px;
  }
  .pub-title {
    display: block;
    font-weight: 500;
    font-size: 0.98rem;
  }
  .pub-meta {
    display: block;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 2px;
    line-height: 1.5;
  }
  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 20px 14px;
  }
  .pub-tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(37, 99, 235, 0.08);
    border-radius: 999px;
    padding: 4px 10px;
    transition: background 0.2s ease;
  }
  .pub-tag:hover {
    background: rgba(37, 99, 235, 0.16);
  }
  .pub-tag-alt {
    color: var(--color-text-muted);
    background: rgba(0, 0, 0, 0.05);
  }
  .pub-tag-alt:hover {
    background: rgba(0, 0, 0, 0.09);
  }
  .more-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }
</style>
