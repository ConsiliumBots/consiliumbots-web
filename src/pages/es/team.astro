---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { activeTeam, researchAffiliates, researchAssociates, board, alumni } from '../../data/site-data.js';

const initials = (name) =>
  name
    .split(' ')
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Salidas más recientes primero; las entradas sin año quedan al final.
const alumniByYear = [...alumni].sort(
  (a, b) => Number(b.departedYear ?? 0) - Number(a.departedYear ?? 0)
);

// Calculado desde los datos para que las cifras nunca se desalineen de la lista.
// A propósito sin "desde <año>": ConsiliumBots se fundó en 2018 y el registro de
// ex integrantes de los primeros años aún está incompleto, así que un año
// derivado subestimaría la historia de la organización.
const byType = (t) => alumni.filter((m) => m.destinationType === t).length;

const alumniStats = [
  {
    n: alumni.length,
    label: 'Ex integrantes',
    desc: 'Colegas que han seguido otros caminos.',
  },
  {
    n: byType('academia'),
    label: 'Continuaron estudios de posgrado',
    desc: 'Programas de doctorado y de políticas públicas en universidades líderes.',
  },
  {
    n: byType('government'),
    label: 'Se integraron al sector público',
    desc: 'Ministerios de educación y trabajo, llevando el trabajo al servicio público.',
  },
  {
    n: byType('industry'),
    label: 'Pasaron a la industria',
    desc: 'Empresas de tecnología y organizaciones con propósito social.',
  },
].filter((s) => s.n > 0);
---

<BaseLayout
  lang="es"
  title="Equipo | ConsiliumBots"
  description="Un equipo diverso e interdisciplinario con base en EE. UU., Chile y Colombia, que trabaja junto a una red de investigadores afiliados."
>
  <section class="page-hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Equipo</h1>
        <p>
          Somos un equipo diverso e interdisciplinario con base en EE. UU., Chile y Colombia, que
          trabaja junto a una red de investigadores afiliados.
        </p>
      </div>
      <video
        class="team-video"
        src="/videos/team-loop.mp4"
        poster="/videos/team-loop-poster.jpg"
        autoplay
        loop
        muted
        playsinline
        width="600"
        height="336"
        aria-label="El equipo de ConsiliumBots reunido en un evento"
      ></video>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Equipo de ConsiliumBots</h2>
      <div class="team-grid">
        {activeTeam.map((m) => (
          <div class="card member">
            <div class="member-head">
              {m.photo ? (
                <img class="member-photo" src={m.photo} alt={m.name} width="56" height="56" loading="lazy" />
              ) : (
                <div class="avatar-initials">{initials(m.name)}</div>
              )}
              <div>
                <h3>{m.name}</h3>
                <p class="member-title">{m.title}</p>
                {m.location && <p class="member-loc">{m.location}</p>}
              </div>
            </div>
            {m.bio && <p class="member-bio">{m.bio}</p>}
            {m.expertise.length > 0 && (
              <div class="tag-row">{m.expertise.slice(0, 5).map((e) => <span class="tag">{e}</span>)}</div>
            )}
            {(m.website || m.scholar) && (
              <p class="member-links">
                {m.website && <a href={m.website} target="_blank" rel="noopener noreferrer">Sitio web</a>}
                {m.scholar && <a href={m.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2 class="section-title">Investigadores afiliados</h2>
      <div class="researcher-grid">
        {researchAffiliates.map((r) => (
          <figure class="researcher">
            {r.photo ? (
              <img src={r.photo} alt={r.name} width="120" height="120" loading="lazy" />
            ) : (
              <div class="avatar-initials avatar-lg">{initials(r.name)}</div>
            )}
            <figcaption>
              <span class="researcher-name">{r.name}</span>
              {r.title && <span class="researcher-title">{r.title}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Investigadores asociados</h2>
      <ul class="associate-list">
        {researchAssociates.map((m) => (
          <li>
            <strong>{m.name}</strong>
            {m.title && <span class="associate-title"> — {m.title}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2 class="section-title">Directorio</h2>
      <div class="board-grid">
        {board.map((b) => (
          <figure class="board-member">
            {b.photo ? (
              <img src={b.photo} alt={b.name} width="140" height="140" loading="lazy" />
            ) : (
              <div class="avatar-initials avatar-lg">{initials(b.name)}</div>
            )}
            <figcaption>
              <span class="researcher-name">{b.name}</span>
              {b.title && <span class="researcher-title">{b.title}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Ex integrantes</h2>
      <p class="alumni-lede">
        Antiguos miembros del equipo que hoy trabajan en gobiernos, en la industria y en programas
        de doctorado alrededor del mundo.
      </p>
      <div class="alumni-stats">
        {alumniStats.map((s) => (
          <div class="alumni-stat">
            <div class="alumni-stat-number">{s.n}</div>
            <div class="alumni-stat-label">{s.label}</div>
            <p class="alumni-stat-desc">{s.desc}</p>
          </div>
        ))}
      </div>
      <ul class="alumni-list">
        {alumniByYear.map((m) => (
          <li class="alumni-row">
            <span class="alumni-year">{m.departedYear}</span>
            <span class="alumni-person">
              <span class="alumni-name">{m.name}</span>
              {m.title && <span class="alumni-role">{m.title}</span>}
            </span>
            {m.currentPosition && <span class="alumni-now">{m.currentPosition}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // Honor reduced-motion: show the poster instead of the looping video.
  const v = document.querySelector<HTMLVideoElement>('.team-video');
  if (v && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.removeAttribute('autoplay');
    v.pause();
  }
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 48px;
    align-items: center;
  }
  .team-video {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(15, 36, 64, 0.18);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .team-video {
      max-width: 480px;
    }
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .member {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .member-head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .member-photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .member-head h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .member-title {
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
    margin: 2px 0 0;
  }
  .member-loc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }
  .member-bio {
    font-size: 0.88rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }
  .member-links {
    display: flex;
    gap: 16px;
    margin: 0;
  }
  .member-links a {
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .researcher-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 28px;
  }
  .researcher,
  .board-member {
    text-align: center;
    margin: 0;
  }
  .researcher img,
  .board-member img {
    width: 100%;
    max-width: 120px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto 10px;
  }
  .board-member img {
    max-width: 140px;
  }
  .avatar-lg {
    width: 120px;
    height: 120px;
    font-size: 1.6rem;
    margin: 0 auto 10px;
  }
  .researcher-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .researcher-title {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 3px;
    line-height: 1.45;
  }

  .associate-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
  }
  .associate-list li {
    font-size: 0.95rem;
  }
  .associate-title {
    color: var(--color-text-muted);
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .alumni-lede {
    color: var(--color-text-light);
    max-width: 60ch;
    margin: -8px 0 28px;
  }
  .alumni-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin: 0 0 40px;
  }
  .alumni-stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .alumni-stat-label {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .alumni-stat-desc {
    font-size: 0.85rem;
    color: var(--color-text-light);
    line-height: 1.5;
    margin: 0;
  }
  @media (max-width: 900px) {
    .alumni-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 480px) {
    .alumni-stats {
      grid-template-columns: 1fr;
    }
  }

  .alumni-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border, #e5e7eb);
  }
  .alumni-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }
  .alumni-year {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }
  .alumni-person {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .alumni-name {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .alumni-role {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .alumni-now {
    font-size: 0.88rem;
    color: var(--color-text-light);
  }
  .alumni-now::before {
    content: '→ ';
    color: var(--color-accent);
  }
  @media (max-width: 640px) {
    .alumni-row {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .alumni-now {
      grid-column: 2;
    }
  }
  .board-member figcaption {
    max-width: 240px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .researcher-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .board-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
    .researcher-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .board-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
