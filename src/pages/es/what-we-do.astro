---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Las familias de herramientas reflejan la taxonomía `type` de src/data/projects.json.
const families = [
  {
    title: 'Chatbots y asistentes de IA',
    body: 'Orientación conversacional por WhatsApp y la web que responde las preguntas de las familias y entrega recomendaciones personalizadas durante los períodos de postulación.',
    examples: [
      { name: 'IcfesBot — Colombia', slug: 'icfesbot' },
      { name: 'Chatbot de Educación Superior — Chile', slug: 'chatbot-highered-chile' },
    ],
  },
  {
    title: 'Cartillas de retroalimentación personalizada',
    body: 'Reportes individualizados que muestran a cada postulante sus opciones y sus riesgos reales de admisión antes de que cierren los plazos.',
    examples: [
      { name: 'Cartillas para estudiantes y familias', slug: 'feedback-reports-families' },
      { name: 'Retroalimentación docente — Ecuador', slug: 'teacher-feedback-ecuador' },
    ],
  },
  {
    title: 'Exploradores de escuelas y carreras',
    body: 'Plataformas de búsqueda que hacen comparables las escuelas, los programas y los resultados laborales para todas las familias.',
    examples: [
      { name: 'MIME — Chile', slug: 'mime-explorer-chile' },
      { name: 'Explorador de Colegios — Colombia', slug: 'explorer-colombia' },
    ],
  },
  {
    title: 'Sistemas de postulación y asignación centralizada',
    body: 'Hemos diseñado y ayudado a operar sistemas centralizados de elección y asignación — desde la gestión del algoritmo hasta la comunicación con los postulantes.',
    examples: [
      { name: 'Sistema de Admisión Escolar — Chile', slug: 'sae-chile' },
      { name: 'New Haven Public Schools — EE. UU.', slug: 'nhps' },
    ],
  },
  {
    title: 'APIs de apoyo a decisiones',
    body: 'Servicios de riesgo y recomendación que se integran a plataformas de gobierno para alertar a los postulantes en tiempo real.',
    examples: [{ name: 'API de Riesgo de Admisión — Pernambuco, Brasil', slug: 'risk-api-pernambuco' }],
  },
];

const approach = [
  {
    icon: '/images/figure-info-interventions.png',
    title: 'Las intervenciones informativas son efectivas',
    body: 'Existe evidencia científica de que brindar información relevante en el momento adecuado puede marcar una diferencia significativa en la forma en que viven las personas, mejorando las decisiones sobre escolaridad, matrícula y acceso a beneficios.',
  },
  {
    icon: '/images/figure-ai.png',
    title: 'Inteligencia Artificial: una realidad ahora disponible',
    body: 'La IA, impulsada por los grandes modelos de lenguaje, ha abierto nuevas posibilidades para entregar información personalizada y dinámica a gran escala, transformando la forma en que las personas toman decisiones sobre educación, vivienda y servicios del gobierno.',
  },
  {
    icon: '/images/figure-centralized.png',
    title: 'Los sistemas y datos centralizados ofrecen una oportunidad',
    body: 'Los procesos de beneficios del gobierno están cada vez más digitalizados y centralizados. Los datos resultantes reducen el costo de acompañar a las familias en la toma de decisiones con información personalizada.',
  },
];
---

<BaseLayout
  lang="es"
  title="Qué Hacemos | ConsiliumBots"
  description="Convertimos información compleja y subutilizada en asistencia virtual y recomendaciones personalizadas, ayudando a las personas a tomar decisiones mejor informadas."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Qué Hacemos</h1>
      <p>
        Convertimos información compleja y subutilizada en asistencia virtual y recomendaciones
        personalizadas.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="lead">
        Nuestra organización sin fines de lucro se dedica a aprovechar la tecnología para
        <strong>conectar los datos del gobierno con la comunidad</strong> con el fin de
        <strong>ayudar a las personas a tomar decisiones mejor informadas que puedan impactar positivamente su bienestar.</strong>
        Nuestra misión es aumentar el <strong>acceso a la educación, la vivienda y otros beneficios del gobierno</strong>
        fomentando la innovación tecnológica, empoderando a quienes más lo necesitan y promoviendo la equidad social
        y económica.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2 class="section-title">Cómo trabajamos</h2>
      <p class="lead how-lead">
        Construimos y operamos herramientas de información gratuitas junto a gobiernos, y medimos su
        impacto con nuestros investigadores afiliados. La mayor parte de nuestro trabajo se organiza
        en cinco familias:
      </p>
      <div class="family-grid">
        {families.map((f) => (
          <div class="family-card">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <div class="family-examples">
              {f.examples.map((e) => (
                <a href={`/projects/${e.slug}`} class="family-example">{e.name} →</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Por qué es importante</h2>
      <div class="approach-grid">
        {approach.map((a) => (
          <div class="approach-card">
            <img src={a.icon} alt="" width="50" height="50" />
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cta-row">
      <div>
        <h2 class="section-title">Míralo en la práctica</h2>
        <p class="lead">Explora los proyectos donde ponemos en práctica este enfoque en América Latina y EE. UU.</p>
      </div>
      <a href="/es/projects" class="btn btn-primary">
        Ver proyectos
        <img src="/icons/arrow-right.svg" alt="" width="20" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 800px;
  }
  .lead strong {
    color: var(--color-text);
  }
  .how-lead {
    margin-bottom: 32px;
  }
  .family-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .family-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .family-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .family-card p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin: 0;
    flex-grow: 1;
  }
  .family-examples {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .family-example {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .family-example:hover {
    text-decoration: underline;
  }
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .approach-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 14px 0 10px;
  }
  .approach-card p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin: 0;
  }
  .cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .cta-row .lead {
    margin: 0;
  }
  @media (max-width: 1024px) {
    .approach-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 768px) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
    .family-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
