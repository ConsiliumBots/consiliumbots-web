---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site-data.js';
import publications from '../../data/publications.json';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://www.consiliumbots.com';

// Breadcrumb structured data: Home > Projects > {project}
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${siteUrl}/projects/` },
    { '@type': 'ListItem', position: 3, name: project.name, item: `${siteUrl}/projects/${project.slug}/` },
  ],
};

// SERPs and social cards clip around 160 chars; keep the full text in the hero.
const truncate = (text, max = 155) => {
  if (!text || text.length <= max) return text;
  const slice = text.slice(0, max);
  const sentence = slice.lastIndexOf('. ');
  if (sentence > 80) return slice.slice(0, sentence + 1);
  return `${slice.slice(0, slice.lastIndexOf(' '))}…`;
};

// Ongoing projects read "2021–present"; equal start/end collapse to one year.
// 'research' efforts are ongoing too (e.g. the CCAS living review); 'proposed'
// projects haven't started, so they get a bare year.
const ongoing = ['active', 'research'].includes(project.status) && !project.endYear;
const years = project.startYear
  ? ongoing
    ? `${project.startYear}–present`
    : project.endYear && project.endYear !== project.startYear
      ? `${project.startYear}–${project.endYear}`
      : `${project.startYear}`
  : (project.endYear ?? null);

// Homepage illustrations reused as hero art where a sensible match exists.
const heroArt = {
  'dfm-chile': 'dfm.svg',
  'dfm-colombia': 'dfm.svg',
  'ccas-review': 'ccas.svg',
  domus: 'subsidy.svg',
  'sae-chile': 'matricula-sae.svg',
  'sae-algorithm-feedback-chile': 'smart-matching.svg',
  nhps: 'smart-matching.svg',
  icfesbot: 'chatbots-ia.svg',
  'osobot-bogota': 'chatbots-ia.svg',
  'chatbot-highered-chile': 'chatbots-ia.svg',
  'ai-agents-100schools': 'chatbots-ia.svg',
  'feedback-reports-families': 'feedback-mineduc.svg',
  'teacher-feedback-ecuador': 'feedback-teachers.svg',
}[project.slug];

// Skip the document already rendered by the "Read the report" button.
const relatedPubs = publications.filter(
  (p) => p.project === project.slug && p.url !== project.publication
);

// Up to 3 related projects, ranked by shared program prefix, type, then country.
// Prefix match is lenient enough to pair a program with its offshoot
// (icfes-nudge-to-search ↔ icfesbot) without matching short generic stems.
const firstToken = project.slug.split('-')[0];
const sameProgram = (token) =>
  token === firstToken ||
  (Math.min(token.length, firstToken.length) >= 4 &&
    (token.startsWith(firstToken) || firstToken.startsWith(token)));

const related = projects
  .filter((p) => p.slug !== project.slug)
  .map((p) => {
    let score = 0;
    if (sameProgram(p.slug.split('-')[0])) score += 3;
    if (p.type && p.type === project.type) score += 2;
    if (p.country && p.country === project.country) score += 1;
    return { p, score };
  })
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((r) => r.p);

const meta = [
  ['Country', [project.country, project.region].filter(Boolean).join(' — ')],
  ['Years', years],
  ['Type', project.type],
  ['Partner', project.partner],
  ['Client', project.client],
  ['Scale', project.scale],
].filter(([, v]) => v);
---

<BaseLayout
  title={`${project.name} | ConsiliumBots`}
  description={truncate(project.description) ?? undefined}
  bilingual={false}
  langSwitchBase="/projects"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />

  <section class="page-hero">
    <div class:list={['wrap', { 'hero-grid': heroArt }]}>
      <div>
        <p class="breadcrumb"><a href="/projects">Projects</a> / {project.name}</p>
        <span class={`badge badge-${project.status}`}>{project.status}</span>
        <h1>{project.name}</h1>
        {project.description && <p>{project.description}</p>}
      </div>
      {heroArt && (
        <img class="hero-art" src={`/images/projects/${heroArt}`} alt="" width="359" height="263" />
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap detail-grid">
      <div class="detail-main">
        {project.targetPopulation && (
          <>
            <h2 class="section-title">Target population</h2>
            <p>{project.targetPopulation}</p>
          </>
        )}

        {project.outcomes.length > 0 && (
          <>
            <h2 class="section-title">Key outcomes</h2>
            <ul class="outcomes">{project.outcomes.map((o) => <li>{o}</li>)}</ul>
          </>
        )}

        {project.costEffectiveness && <p class="highlight-note">{project.costEffectiveness}</p>}

        {project.contributors.length > 0 && (
          <>
            <h2 class="section-title">Team</h2>
            <ul class="contributors">
              {project.contributors.map((c) => (
                <li><strong>{c.name}</strong>{c.role ? ` — ${c.role}` : ''}</li>
              ))}
            </ul>
          </>
        )}

        {project.website && (
          <p>
            <a class="btn-arrow" href={project.website} target="_blank" rel="noopener">
              Visit the project
              <img src="/icons/arrow-outward.svg" alt="" width="16" />
            </a>
          </p>
        )}

        {project.publication && (
          <p>
            <a class="btn-arrow" href={project.publication} target="_blank" rel="noopener noreferrer">
              Read the report
              <img src="/icons/arrow-outward.svg" alt="" width="16" />
            </a>
          </p>
        )}

        {relatedPubs.length > 0 && (
          <>
            <h2 class="section-title">Research from this project</h2>
            <div class="pub-list">
              {relatedPubs.map((p) => (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="pub-item">
                  <span class="pub-title">{p.title}</span>
                  <span class="pub-meta">{[p.authors, p.venue, p.year].filter(Boolean).join(' · ')}</span>
                </a>
              ))}
            </div>
          </>
        )}
      </div>

      <aside class="detail-side">
        <div class="meta-list">
          {meta.map(([k, v]) => (
            <div class="meta-row">
              <span class="meta-k">{k}</span>
              <span class="meta-v">{v}</span>
            </div>
          ))}
        </div>

        {project.technologies.length > 0 && (
          <div class="side-block">
            <span class="meta-k">Technologies</span>
            <div class="tag-row">{project.technologies.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        )}

        {project.funders.length > 0 && (
          <div class="side-block">
            <span class="meta-k">Funders</span>
            <div class="tag-row">{project.funders.map((f) => <span class="tag">{f}</span>)}</div>
          </div>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <div class="wrap related-wrap">
        <h2 class="section-title">Related projects</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a href={`/projects/${p.slug}`} class="related-card">
              <span class="related-name">{p.name}</span>
              {(p.country || p.type) && (
                <span class="related-meta">{[p.country, p.type].filter(Boolean).join(' · ')}</span>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="wrap"><a href="/projects" class="btn-arrow">← All projects</a></div>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: center;
  }
  .hero-art {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 8px;
  }
  .pub-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 14px 18px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .pub-item:hover {
    border-color: var(--color-accent);
    box-shadow: 0 3px 12px rgb(var(--navy-rgb) / 0.07);
  }
  .pub-title {
    font-weight: 500;
    font-size: 0.97rem;
    line-height: 1.45;
  }
  .pub-meta {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .related-wrap {
    margin-bottom: 32px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 16px 18px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .related-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 3px 12px rgb(var(--navy-rgb) / 0.07);
  }
  .related-name {
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .related-meta {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: start;
    margin-bottom: 32px;
  }
  .detail-main h2 {
    margin-top: 28px;
  }
  .detail-main h2:first-child {
    margin-top: 0;
  }
  .outcomes {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 8px;
  }
  .contributors {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .outcomes li,
  .contributors li {
    font-size: 0.95rem;
    color: var(--color-text-light);
  }
  .highlight-note {
    background: var(--color-bg-light);
    border-left: 3px solid var(--color-accent);
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 0.95rem;
    margin: 16px 0;
  }
  .detail-side {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 24px;
  }
  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 14px;
  }
  .meta-k {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .meta-v {
    font-size: 0.92rem;
    color: var(--color-text);
  }
  .side-block {
    margin-top: 18px;
  }
  .side-block .meta-k {
    display: block;
    margin-bottom: 8px;
  }
  @media (max-width: 900px) {
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-art {
      max-width: 340px;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
